-    -- the union declaration is refused for a missing one, never for an empty one.
-    """
-
-    return tuple(
-        DetectionCounterpartProbe(
-            item_id=item.item_id, item_kind=str(item.kind), coverage=item.coverage
-        )
-        for item in _items(result)
-    )
