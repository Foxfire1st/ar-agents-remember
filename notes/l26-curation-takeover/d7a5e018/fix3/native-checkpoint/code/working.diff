-                targets=[target(CODE_FILE, locator={"kind": "column", "value": "3"})],
-            ),
-        ],
-    )
-
-    assert report.committed == ()
-    refused = by_id(report.refused)
-    assert set(refused) == {
-        "E-not-integer",
-        "E-reversed",
-        "E-zero",
-        "E-past-end",
-        "E-unknown-kind",
