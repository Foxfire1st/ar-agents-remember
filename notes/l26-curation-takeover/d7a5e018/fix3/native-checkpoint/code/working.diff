-    ".pyi": "python",
-    ".ts": "typescript",
-    ".tsx": "typescript",
-    ".js": "javascript",
-    ".jsx": "javascript",
-    ".md": "markdown",
-    ".toml": "toml",
-    ".json": "json",
-    ".sh": "shell",
-    ".sql": "sql",
