-    try:
-        joined = Path(base, relative)
-    except (OSError, ValueError, TypeError):  # pragma: no cover - an unjoinable pair names nothing
-        return None
-    base_parts = Path(base).parts
-    if joined == Path(base) or joined.parts[: len(base_parts)] != base_parts:
-        return None
-    return joined
