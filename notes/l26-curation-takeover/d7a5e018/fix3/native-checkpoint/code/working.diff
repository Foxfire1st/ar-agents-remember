-    if isinstance(endpoint, RealizationClaimCoverage):
-        return (claim_id, endpoint.kind, endpoint.claim_id, endpoint.claim_id, None)
-    return (claim_id, endpoint.kind, endpoint.anchor_id, None, endpoint.anchor_id)
