-def _freeze_merged(
-    merged_path: Path, merged_identity: SnapshotIdentity, workspace: Path
-) -> PreparedKnowledgeSnapshot | KnowledgeRefusal:
-    """Freeze the merged temporary through the closed-snapshot procedure under its own lock.
