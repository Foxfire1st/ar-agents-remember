-    _write_files(memory_root, {f"onboarding/{MEMORY_CARD}": _MEMORY_CARD_TEXT})
-    _write_files(root, {OUTSIDE_PATH: "# terminal report\nlanded\n"})
-    _git(code_root, ["init", "-q", "--initial-branch=main"])
