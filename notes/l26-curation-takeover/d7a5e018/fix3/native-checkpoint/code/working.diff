-    if kind == _FILE_KIND:
-        return FileLocator()
-    if kind == _RANGE_KIND:
-        return _range_locator(locator, resolved)
-    if kind == _SYMBOL_KIND:
-        return _symbol_locator(locator, resolved)
-    return _Refusal(
-        _CODE_LOCATOR_KIND,
-        f"the locator kind {kind!r} is not one of file, line_range or symbol",
-    )
