-
-def _graph_of(edges: Sequence[tuple[str, str]]) -> dict[str, set[str]]:
-    graph: dict[str, set[str]] = {}
-    for child, parent in edges:
-        graph.setdefault(child, set()).add(parent)
-        graph.setdefault(parent, set())
-    return graph
