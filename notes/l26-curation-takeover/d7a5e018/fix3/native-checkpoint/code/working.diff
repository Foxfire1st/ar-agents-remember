-    return map_sqlite_error(
-        error,
-        SqliteFailureContext(
-            operation="change_candidate",
-            table="candidate",
-            record_id=f"{position}:{kind}" if position is not None else "outside_the_apply_loop",
-        ),
-    )
-
-
-__all__ = [
-    "change_candidate",
-    "require_candidate_lane",
-    "require_writable_lane",
-]
