-def _unresolved_reason(
-    written: str,
-    code_tree: Trees,
-    memory_tree: Trees,
-    admission: KnowledgeWriteAdmission,
-    top_level: frozenset[str],
-) -> str:
-    """Which of the three ways a *confined* path resolves to nothing this path took.
