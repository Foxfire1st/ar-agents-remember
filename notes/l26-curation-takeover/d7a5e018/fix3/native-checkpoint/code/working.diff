-FILE_LEVEL_CARD_FORMAT = "file-level-onboarding-card/v1"
-ROUTE_OVERVIEW_FORMAT = "route-local-overview/v1"
-
-# The one declared form this parser refuses. It is declared rather than omitted so that the refusal is
