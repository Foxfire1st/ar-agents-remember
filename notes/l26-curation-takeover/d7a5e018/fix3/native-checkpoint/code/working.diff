-    (_CONFLICT_DATA, False): "conflicting_values",
-    (_CONFLICT_NOTFOUND, False): "missing_expected_row",
-    (_CONFLICT_CONFLICT, False): "duplicate_identity",
-    (_CONFLICT_CONSTRAINT, True): "duplicate_relationship",
