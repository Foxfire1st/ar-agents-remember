-    return tuple(
-        _committed_outcome(
-            plan,
-            tuple(
-                RouteOutcome(target.route_path, target.route_id, _ROUTE_PROJECTED)
-                if target.route_path is not None
-                else RouteOutcome(None, None, _ROUTE_UNGOVERNED)
-                for target in plan.targets
