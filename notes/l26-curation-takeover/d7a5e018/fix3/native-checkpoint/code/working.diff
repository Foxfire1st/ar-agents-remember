-        return None
-    for line in lines[header + 2 :]:
-        cells = _cells(line)
-        if not cells or len(cells) != _METADATA_CELLS:
-            return None
-        if cells[0] == _DOC_TYPE_ROW:
-            return cells[1].strip().strip("`") or None
-    return None
