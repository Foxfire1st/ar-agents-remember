    "4": {
      "note": "The Manager's report names its rulings, requirement-change and status records, developer-decision and final report-path messages, exact handover evidence and pending questions; its boundary keeps task truth and paired Git publication with their existing owners.",
      "targets": [
        {
          "anchor": {
            "blob": "d5ea59401b00821cc84191bb29d749dcc1e6b6aa",
            "content": "sha256:60e0f0b31667b300769b3597a51bc4e4cc44c67ba2005d878d3269988e6e2ffc",
