          "kind": "code"
        }
      ]
    },
    "5": {
      "note": "Manager routes Architect matters, developer-needed matters and permission notices to the recorded reporting recipient or handover parent (routing Architect matters through an assigned Orchestrator except direct qualifying skeleton handovers), sends no status-only messages, records undelivered matters and continues independent work; the final report-path return uses the parent role with task references.",
      "targets": [
        {
          "anchor": {
            "blob": "d5ea59401b00821cc84191bb29d749dcc1e6b6aa",
            "content": "sha256:929628775451d4031554159cfafea556369428106b6d562aa60549c19e18c007",
