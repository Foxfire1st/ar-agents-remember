      "origin": {
        "leaf": "260921-ICR-L46"
      },
      "rationale": "Is the entry's only knowledge read when a leaf is selected: one intentReviewSummary request per repo/master/leaf key, repeated only when that leaf's projection facts change, with just the latest request allowed to store its answer. It returns loading for any other key, and a rejected request becomes an unavailable state rather than counts.",
      "role": "primary-authority"
    }
