      "origin": {
        "leaf": "260921-ICR-L48"
      },
      "rationale": "Starts each review read with its own sequence number and superseded flag, keeps the displayed review mounted only for a cursor continuation of the same question that is not a refresh (continuedReview), drops any answer that is no longer the current read, and passes an admitted answer through familyContinuationRead, which turns a rejected page into a failed read while leaving the retained review displayed.",
      "role": "primary-authority"
    }
