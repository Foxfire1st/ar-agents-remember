      "origin": {
        "handoffEntry": "MIK-R39@v1-other-selections-start-afresh",
        "leaf": "260928-MIK-L39"
      },
      "rationale": "Gives the header's refresh control `refreshReview` and the surface's failure block `retryReview` and `openTaskContext`, so no control of the surface reads again or opens the task context without the tree intent being set.",
      "role": "propagation-persistence"
    },
    {
      "anchor": {
        "blob": "7c6601ddf7269a084e197eb6ae1f071a8c3acef6",
        "content": "sha256:a4cb15f991923645d5bd6bd9654729ebd68da71c047ec096d8112ba5087c5a36",
        "locator": {
