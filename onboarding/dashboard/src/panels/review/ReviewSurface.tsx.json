      "invariant": "INV-WQZ2WFCN",
      "origin": {
        "leaf": "260921-ICR-L48"
      },
      "rationale": "Turns an unanswered read (pending, failed or refused) into the reading status bound to the requested question's key and subject label, carrying the owner's problem block for a failure or refusal.",
      "role": "primary-authority"
    }
