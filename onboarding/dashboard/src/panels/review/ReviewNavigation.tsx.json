        }
      },
      "id": "RLZ-ZCE8D5GH",
      "invariant": "INV-EPB2CXBE",
      "origin": {
        "leaf": "260921-ICR-L46"
      },
      "rationale": "Holds the first review read only while no subject is chosen or named and the catalogue has neither answered nor refused. A SUBJECT_HOLD_MS timer then ends the hold for that key, so a slow or stalled catalogue releases into the task-context review instead of blocking it.",
      "role": "primary-authority"
    }
  ],
