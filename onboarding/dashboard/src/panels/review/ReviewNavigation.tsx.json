        }
      },
      "id": "RLZ-TT5XGFN4",
      "invariant": "INV-2E8MG43K",
      "origin": {
        "leaf": "260921-ICR-L46"
      },
      "rationale": "Reads the recorded-subject catalogue through useReviewCatalogue when the reviewer is mounted, keyed on this comparison and its snapshot generation, and returns that whole catalogue with the chosen subject and onSelect, so every subject the catalogue records is selectable inside the review.",
      "role": "primary-authority"
    },
    {
      "anchor": {
        "blob": "00b6a54df559165d59f5c46c8a1ab31d6701367a",
        "content": "sha256:9413f7df828e707acd31a1c8799e2cd20451930fbd8dd55086d2ab09cef28501",
        "locator": {
          "kind": "symbol",
          "name": "useReviewNavigation"
        }
      },
      "id": "RLZ-WBPK96KD",
      "invariant": "INV-RMTHRQ0K",
      "origin": {
        "leaf": "260921-ICR-L48"
      },
      "rationale": "Its engage callback freezes the subject on screen as the reader's own choice once the bounded wait has released a read, without overwriting an explicit selection queued by the same gesture.",
      "role": "primary-authority"
    },
    {
      "anchor": {
        "blob": "00b6a54df559165d59f5c46c8a1ab31d6701367a",
        "content": "sha256:9413f7df828e707acd31a1c8799e2cd20451930fbd8dd55086d2ab09cef28501",
        "locator": {
          "kind": "symbol",
