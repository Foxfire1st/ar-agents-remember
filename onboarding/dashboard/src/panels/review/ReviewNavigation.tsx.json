      },
      "rationale": "Fixes the bound of the first-read hold at 750 ms, the value the navigation's timer uses before releasing a stalled catalogue into the task-context review.",
      "role": "support"
    },
    {
      "anchor": {
        "blob": "00b6a54df559165d59f5c46c8a1ab31d6701367a",
        "content": "sha256:9413f7df828e707acd31a1c8799e2cd20451930fbd8dd55086d2ab09cef28501",
        "locator": {
          "kind": "symbol",
