    },
    "8": {
      "note": "When its part is complete the Curator marks only its own task-document step done through task_doc set_step with a one-line note; an incomplete, blocked or progress report never marks unfinished work done.\n\nAnchor: `task_doc`",
      "targets": [
        {
          "anchor": {
            "blob": "a5e5850910f15122f4c36b9762f352f918e0ecb6",
            "content": "sha256:9fc1029ada509e1f4ceb7fbf037f09f8d905cba800f712197f1a8dad7bf6151f",
