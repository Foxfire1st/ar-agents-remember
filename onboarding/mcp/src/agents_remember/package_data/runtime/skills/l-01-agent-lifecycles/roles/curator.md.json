    "7": {
      "note": "The Curator writes knowledge with knowledge_write or the admitted serving-build command-line writer with the task contract, handoff list and commit; the commit option authorizes file writes, not Git or acceptance.\n\nAnchor: `knowledge_write`",
      "targets": [
        {
          "anchor": {
            "blob": "a5e5850910f15122f4c36b9762f352f918e0ecb6",
