          },
          "kind": "code"
        }
      ]
    },
    "14": {
      "note": "For every card cut by the quality check the Curator names the source evidence that makes the removed text untrue; text is never removed merely to clear a quality finding.",
      "targets": [
        {
          "anchor": {
            "blob": "a5e5850910f15122f4c36b9762f352f918e0ecb6",
            "content": "sha256:37c54ce0b5a5a9fef8c43de9bd9c0b39bfa0bf19e275f58e28da1d3f0efc8fd7",
            "locator": {
              "end": 118,
