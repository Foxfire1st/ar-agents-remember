          },
          "kind": "code"
        }
      ]
    },
    "15": {
      "note": "The Curator also repairs wrong or missing memory it encounters while curating, whoever left it and beyond the quality check's findings, through the writer; it names each repair, makes no broad sweep and routes repairs needing code, a requirement decision or another leaf's work.",
      "targets": [
        {
          "anchor": {
            "blob": "a5e5850910f15122f4c36b9762f352f918e0ecb6",
            "content": "sha256:f898ec3148ecaeb74251252927c4c5e8ce0edfffdb5573f0e13004aec0353bc2",
