    "13": {
      "note": "The leaf pass starts only on a leaf task document, never taskless; registered tasks belong to a master, and no standalone leaf, fake task, worktree or enclosure is fabricated for the leaf or foundation route.",
      "targets": [
        {
          "anchor": {
            "blob": "a5e5850910f15122f4c36b9762f352f918e0ecb6",
            "content": "sha256:7d29c8551fceea6befa2bb3368b9e56702729dafe74d57b7b0f84a8c5bd9f7f6",
            "locator": {
