    "2": {
      "note": "`agents-live` reads unarchived agent IDs through `daemon.fetchAgents`, at most ten pages of 200 entries. It reports `complete` only when the runtime explicitly says `hasMore: false`; a bound or missing next cursor ends the read without establishing absence. It neither resumes agents nor reads their timelines. Whole-reply transport remains separately owned by `closingText`.",
      "targets": [
        {
          "anchor": {
            "blob": "9d3aaac0b29e3a14f25634f49bc75bdd33f723dd",
            "content": "sha256:7cc333bd70aa4a1960ffbfc76827b654d6ddbfd52abc5233745df5e9692bd1ae",
            "locator": {
