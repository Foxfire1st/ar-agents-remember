      },
      "id": "RLZ-MMSNGJN5",
      "invariant": "INV-4RERAJCC",
      "origin": {
        "leaf": "260921-ICR-L46"
      },
      "rationale": "Resolves the one requested path to a file inside tasks/, reads and schema-checks only that payload, and projects its body with master_docs taken from _graph_master_docs. It never calls a corpus enumeration, so the read's cost does not depend on how many unrelated tasks exist.",
      "role": "primary-authority"
    }
  ],
