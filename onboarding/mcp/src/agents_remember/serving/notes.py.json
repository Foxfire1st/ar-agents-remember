      "id": "RLZ-W8VA2JEP",
      "invariant": "INV-QR24S1VH",
      "origin": {
        "leaf": "260921-ICR-L55"
      },
      "rationale": "Re-opens an in-root directory symlink's resolved target one path component at a time from the root descriptor with O_NOFOLLOW, so a component retargeted during the walk cannot redirect descent outside the notes root.",
      "role": "enforcement"
    }
