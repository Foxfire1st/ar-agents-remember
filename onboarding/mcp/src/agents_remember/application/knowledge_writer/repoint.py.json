  "references": {
    "1": {
      "note": "`repointed_links` re-points the named fired links, refreshes every other fired link as today, and returns the links, the refusals, whether anything was judged and the row's stored items.",
      "targets": [
        {
          "anchor": {
            "blob": "f6dd3fa6bb431ea9ffec7301f9ab7bd2bda866df",
            "content": "sha256:a1bd209053c8abea172f1af9b1c0d3028b3850c691bd9b3f702084cdba8fbfea",
            "locator": {
              "kind": "symbol",
              "name": "repointed_links"
            }
          },
          "kind": "code"
        }
      ]
    },
    "2": {
      "note": "An item is admitted only for a link that fired on the answered item with `anchor`, `anchor_stale` or `refresh_not_current`, and that is still a `reconsider_on` link of the answered alternative; a `refresh_not_current` item must be named in the row's `items`.",
      "targets": [
        {
          "anchor": {
