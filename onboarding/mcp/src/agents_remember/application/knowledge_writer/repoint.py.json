              "name": "_anchor_refusal"
            }
          },
          "kind": "code"
        }
      ]
    },
    "4": {
      "note": "A `refresh_not_current` item may replace only the earlier refresh it fired on, or the identical re-point a rerun writes; any other current target refuses with \"recompute the worklist, or `raise`\".",
      "targets": [
        {
          "anchor": {
