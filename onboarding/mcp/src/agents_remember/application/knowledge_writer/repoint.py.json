              "name": "_admission"
            }
          },
          "kind": "code"
        }
      ]
    },
    "3": {
      "note": "An anchor-triggered item is admitted when the link stands at the fired base target or already names this re-point; a link that still maps to C keeps its refresh, and any other current target is refused.",
      "targets": [
        {
          "anchor": {
            "blob": "f6dd3fa6bb431ea9ffec7301f9ab7bd2bda866df",
            "content": "sha256:9813d1df58672f852dad065f3361877b79cead322d187918988940c3f5b6e84a",
