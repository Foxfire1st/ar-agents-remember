        "content": "sha256:cb671714773cb6deb3b2bbf58289ade8bce5d720e292b5cd4d83d8a4cea125b7",
        "locator": {
          "kind": "symbol",
          "name": "_recorded_range_resolution"
        }
      },
      "id": "RLZ-BBB7V6PT",
      "invariant": "INV-8Q6DZTDB",
      "origin": {
        "leaf": "260921-ICR-L46"
      },
      "rationale": "When no frozen generation exists, builds the closed-leaf resolution from recorded_committed_range and read_recorded_knowledge: the code sides are the recorded base commit and head tree, the knowledge sides are the per-side recorded datasets, and an absent recorded endpoint returns a named refusal instead of a substitute.",
      "role": "primary-authority"
    }
  ],
