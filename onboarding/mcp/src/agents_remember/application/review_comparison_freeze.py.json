      "invariant": "INV-7W11WKKN",
      "origin": {
        "leaf": "260921-ICR-L46"
      },
      "rationale": "Uses explicitly supplied records when options carry them and otherwise collects owner records for the exact resolved pair through review_records_for_resolution. It refuses when the assessment channel is unavailable because its artifacts are unreadable, and it freezes only what compose_review actually composed, passing the same records to the single generation owner.",
      "role": "primary-authority"
    }
