          "name": "_no_single_head"
        }
      },
      "id": "RLZ-CC2NVWCA",
      "invariant": "INV-R93S8Y30",
      "origin": {
        "leaf": "260921-ICR-L46"
      },
      "rationale": "Decides when one side has no single head for an identity: several heads, or a populated identity with none. _classify uses it to count that identity as unresolved (making the summary partial) instead of as an unchanged zero.",
      "role": "support"
    },
    {
      "anchor": {
