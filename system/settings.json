{
  "version": 2,
  "onboarding": {
    "storage": {
      "mode": "memory-repo"
    },
    "pathRules": {
      "include": {
        "paths": [
          "AGENTS.md",
          "README.md",
          "dashboard/src/**",
          "examples/mcp/**",
          "installer/**",
          "mcp/**",
          "runtime/**",
          "scripts/**"
        ],
        "fileTypes": [
          ".css",
          ".json",
          ".md",
          ".patch",
          ".py",
          ".sh",
          ".toml",
          ".ts",
          ".tsx",
          ".txt"
        ]
      },
      "exclude": {
        "paths": [
          "docs/**",
          "CODE_OF_CONDUCT.md",
          "CONTRIBUTING.md",
          "SECURITY.md",
          "LICENSE",
          "roadmap/**",
          "benchmarks/user-runs/**",
          "benchmarks/workspaces/**",
          "mcp/src/agents_remember/package_data/benchmarks/**",
          "mcp/src/agents_remember/package_data/dashboard/**",
          "node_modules/**",
          "vendor/**",
          "dist/**",
          "build/**",
          "coverage/**",
          ".cache/**",
          ".pytest_cache/**",
          ".venv/**",
          ".idea/**",
          ".vscode/**",
          ".env",
          ".env.*",
          "**/generated/**",
          "**/*.generated.*",
          "**/*.Zone.Identifier",
          "**/*:Zone.Identifier"
        ],
        "fileTypes": [
          ".gif",
          ".jpeg",
          ".jpg",
          ".png",
          ".zip"
        ]
      }
    }
  },
  "crossRepo": {
    "allow": []
  }
}
